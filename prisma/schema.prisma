// Prisma schema — Vivetutiempo (Block 1: Core)
//
// Domain model per openspec/changes/bootstrap-vivetutiempo-platform/design.md.
// Includes the D8 additions (ProfileStatus.DEACTIVATED, Profile.reviewRequestedAt,
// Session model) and the login-rate-limiter window table (D7/M4). The two
// partial unique indexes required by ADR D4 cannot be expressed in Prisma —
// they live in the raw-SQL migration (see prisma/migrations, B1).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountRole {
  ADMIN
  HOSPITAL
  ARTIST
  PATIENT
}

enum ProfileType {
  HOSPITAL
  ARTIST
}

enum ProfileStatus {
  PENDING
  ACTIVE
  REJECTED
  DEACTIVATED
}

enum SlotStatus {
  OPEN
  FILLED
  CLOSED
}

enum ProposalStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
}

enum EventStatus {
  CREATED
  PUBLISHED
  COMPLETED
}

model Account {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  role         AccountRole
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  profile  Profile?
  sessions Session[]

  @@map("accounts")
}

// DB-backed session row (ADR D1/D7/D8). Stores only a SHA-256 hash of the
// opaque, CSPRNG-generated bearer token — a leaked row (backup, log,
// replica) is never a usable live session. Absolute + idle expiry per D7.
model Session {
  id                String   @id @default(cuid())
  accountId         String
  account           Account  @relation(fields: [accountId], references: [id])
  tokenHash         String   @unique
  absoluteExpiresAt DateTime
  lastActiveAt      DateTime
  createdAt         DateTime @default(now())

  // Required by SessionPort.revokeAllForAccount (D7/M3).
  @@index([accountId])
  @@map("sessions")
}

// Login-rate-limiter rolling window (ADR D7, M4 pr2-review). `key` is a
// SHA-256 hash of the scoped identifier (account email or truncated IP) —
// no raw email/IP is ever stored here. Retention/cleanup policy: rows whose
// window has fully lapsed are purged opportunistically on every isAllowed
// check and deleted on successful login — expired windows are never
// retained indefinitely.
model LoginAttemptWindow {
  key             String   @id
  failureCount    Int      @default(0)
  windowStartedAt DateTime

  @@map("login_attempt_windows")
}

model Profile {
  id        String        @id @default(cuid())
  accountId String        @unique
  account   Account       @relation(fields: [accountId], references: [id])
  type      ProfileType
  name      String
  status    ProfileStatus @default(PENDING)
  // Durable evidence of the latest review request (D8/B3): a re-registration
  // (`rejected -> pending`, M2) updates this timestamp so Admin traceability
  // survives a restart. Full review-history table is BACKLOG.
  reviewRequestedAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // HOSPITAL side
  slots Slot[] @relation("HospitalSlots")

  // ARTIST side
  proposals Proposal[] @relation("ArtistProposals")

  @@map("profiles")
}

model Slot {
  id                String   @id @default(cuid())
  hospitalProfileId String
  hospitalProfile   Profile  @relation("HospitalSlots", fields: [hospitalProfileId], references: [id])
  title             String
  description       String
  scheduledAt       DateTime
  durationMinutes   Int
  location          String
  status            SlotStatus @default(OPEN)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  proposals Proposal[]
  event     Event?

  @@map("slots")
}

model Proposal {
  id              String         @id @default(cuid())
  slotId          String
  slot            Slot           @relation(fields: [slotId], references: [id])
  artistProfileId String
  artistProfile   Profile        @relation("ArtistProposals", fields: [artistProfileId], references: [id])
  message         String
  status          ProposalStatus @default(SUBMITTED)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  event Event?

  // NOTE (ADR D4, B1 pr2-review): Prisma cannot express partial unique
  // indexes. Two invariants are enforced by the raw-SQL migration
  // `prisma/migrations/*_partial_unique_indexes/migration.sql`:
  //   - UNIQUE("slotId") WHERE "status" = 'ACCEPTED'::"ProposalStatus"
  //   - UNIQUE("slotId","artistProfileId") WHERE "status" = 'SUBMITTED'::"ProposalStatus"
  // Do NOT rely on @@unique([slotId]) here — it would block the
  // resubmit-after-reject flow required by the spec.
  @@map("proposals")
}

model Event {
  id         String      @id @default(cuid())
  slotId     String      @unique
  slot       Slot        @relation(fields: [slotId], references: [id])
  proposalId String      @unique
  proposal   Proposal    @relation(fields: [proposalId], references: [id])
  title      String
  status     EventStatus @default(CREATED)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@map("events")
}
