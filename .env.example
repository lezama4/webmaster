# Copy this file to .env and adjust values for your local environment.
# Never commit the real .env file.

# Local PostgreSQL (see docker-compose.yml)
DATABASE_URL="postgresql://vivetutiempo:vivetutiempo@localhost:5432/vivetutiempo?schema=public"

# Session secret fallback for server-side security adapters (generate a long
# random value for real environments; never expose it to the browser).
SESSION_SECRET="change-me-in-local-env"

# Login-rate-limiter key HMAC secret (pr2b-N2) — pseudonymizes the
# email/IP scoped keys stored in login_attempt_windows.key so a leaked
# table cannot be dictionary-attacked back to a candidate email. Falls
# back to SESSION_SECRET if unset; a dedicated secret is preferred so its
# rotation schedule is independent of session-cookie signing.
RATE_LIMIT_HMAC_SECRET="change-me-in-local-env-too"
